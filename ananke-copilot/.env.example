# ── Data layer ──────────────────────────────────────────────────────────────
# The copilot reads OHLCV straight from TimescaleDB (helpers/db.tsx) and falls
# back to the Spring backend / Alpaca when a range is missing.
FLOOT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stockdb

# ── Alpaca ──────────────────────────────────────────────────────────────────
# Same pair as the repo-root .env; used for symbol search and gap fetches.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# ── Kimi (Moonshot) ─────────────────────────────────────────────────────────
# Platform API key from https://platform.moonshot.ai/console/api-keys
# (China console: https://platform.moonshot.cn — then set KIMI_BASE_URL to the
# .cn endpoint below).
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
# KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2-0905-preview
