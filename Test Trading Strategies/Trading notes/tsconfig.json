## BATCH 6 — Feature Calculator
*Build on top of Batch 5. cpp-engine branch.*

Context to give Claude Code:
"Read all existing files in Anake/cpp-engine/src/ before making changes."

What to build:
FeatureCalculator class in src/engine/FeatureCalculator.hpp and .cpp:

    struct Bar {
        time_t time;
        double open, high, low, close, volume, vwap;
    };
    
    class FeatureCalculator {
    public:
        FeatureCalculator(const vector<string>& required_features,
                         int lookback_period = 50);
        
        // Add a new bar to the history
        void update(const Bar& bar);
        
        // Returns true when enough bars have been seen to calculate all features
        bool isReady() const;
        
        // Calculate all required features from current bar history
        // Returns map of feature_name -> value
        map<string, float> calculate();
        
    private:
        deque<Bar> history;
        vector<string> required_features;
        int lookback_period;
        
        // Individual feature calculations
        float rsi(int period);
        float ema(int period);
        float sma(int period);
        float volume_delta();
        float vwap_distance();
        float bollinger_pct(int period, float std_dev);
        
        // Feature name parser
        // "rsi_14" -> calls rsi(14)
        // "ema_9" -> calls ema(9)
        float calculateFeature(const string& feature_name);
    };

Verification:
    FeatureCalculator calc({"rsi_14", "ema_9", "ema_21", "volume_delta"}, 50);
    
    // Feed 60 bars
    for (auto& bar : test_bars) {
        calc.update(bar);
    }
    
    assert(calc.isReady());
    
    auto features = calc.calculate();
    assert(features.count("rsi_14") > 0);
    assert(features["rsi_14"] >= 0 && features["rsi_14"] <= 100);
    cout << "RSI: " << features["rsi_14"] << endl;
