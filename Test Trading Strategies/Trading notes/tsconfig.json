## BATCH 7 — Alpaca WebSocket Feed
*Build on top of Batch 6. cpp-engine branch.*

Context to give Claude Code:
"Read all existing files in Anake/cpp-engine/src/ before making changes.
Alpaca WebSocket streaming docs:
https://docs.alpaca.markets/reference/stream-market-data"

What to build:
MarketDataFeed class in src/feed/MarketDataFeed.hpp and .cpp:

    class MarketDataFeed {
    public:
        MarketDataFeed(const string& api_key,
                      const string& api_secret,
                      const string& mode); // "paper" or "live"
        
        // Subscribe to bars for a symbol
        // callback is called on every new bar
        void subscribe(const string& symbol,
                      function<void(const Bar&)> callback);
        
        // Start the WebSocket connection (blocking)
        void start();
        
        // Stop gracefully
        void stop();
        
        // Reconnect on disconnect
        void reconnect();
        
    private:
        string api_key, api_secret, mode;
        map<string, function<void(const Bar&)>> callbacks;
        bool running = false;
        
        // WebSocket URL
        // paper: wss://stream.data.alpaca.markets/v2/iex
        // live:  wss://stream.data.alpaca.markets/v2/sip
        string getStreamUrl() const;
        
        // Auth message
        // {"action":"auth","key":"...","secret":"..."}
        string buildAuthMessage() const;
        
        // Subscribe message
        // {"action":"subscribe","bars":["NVDA"]}
        string buildSubscribeMessage(const vector<string>& symbols) const;
        
        // Parse incoming bar JSON to Bar struct
        Bar parseBar(const nlohmann::json& j) const;
    };

Verification:
    MarketDataFeed feed(api_key, api_secret, "paper");
    
    feed.subscribe("NVDA", [](const Bar& bar) {
        cout << "New bar: close=" << bar.close
             << " volume=" << bar.volume << endl;
    });
    
    feed.start(); // blocks — should print bars as they arrive during market hours

