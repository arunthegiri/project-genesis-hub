The ONNX Runtime C++ API documentation is at:
https://onnxruntime.ai/docs/api/c/"

What to build:
ONNXModel class in src/inference/ONNXModel.hpp and .cpp:

    class ONNXModel {
    public:
        ONNXModel(const string& model_path, const EngineConfig& config);
        
        // Takes a map of feature_name -> value
        // Returns probability for each output class
        map<string, float> predict(const map<string, float>& features);
        
        // Returns BUY, SELL, or HOLD based on thresholds
        string getSignal(const map<string, float>& features);
        
        // Returns confidence score for the signal
        float getConfidence(const map<string, float>& features);
        
    private:
        Ort::Env env;
        Ort::Session session;
        EngineConfig config;
        vector<string> input_names;
        vector<string> output_names;
        
        // Converts feature map to ONNX input tensor
        // Features must be in exact order as config.features
        vector<float> buildInputTensor(const map<string, float>& features);
    };

Verification:
